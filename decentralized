                'runs-on': 'ubuntu-latest',
                'needs': ['code-quality', 'tests', 'security'],
                'if': "github.ref == 'refs/heads/main'",
                'steps': [
                    {'uses': 'actions/checkout@v3'},
                    {'uses': 'actions/setup-python@v4', 'with': {'python-version': '3.11'}},
                    {'run': 'python -m pip install build'},
                    {'run': 'cd decentralized-ai-simulation && python -m build'},
                    {'run': 'docker build -t decentralized-ai-simulation:latest .'}
                ]
            }
        }
    }
    
    return yaml.dump(workflow, default_flow_style=False)

# Save GitHub Actions workflow
def setup_ci_cd(project_root: Path) -> None:
    """Set up CI/CD pipeline infrastructure."""
    workflow_dir = project_root / '.github' / 'workflows'
    workflow_dir.mkdir(parents=True, exist_ok=True)
    
    workflow_content = create_github_actions_workflow()
    (workflow_dir / 'ci-cd.yml').write_text(workflow_content)
    
    logger.info("CI/CD pipeline setup completed")

