class ErrorHandler:
    """
    Centralized error handling and recovery system.
    Provides consistent error handling across the application.
    """
    
    def __init__(self, component_name: str = "main"):
        self.component = component_name
        self.error_counts = {}
        self.recent_errors = []
        self.max_recent_errors = 100
        self.recovery_strategies = {}
        self.error_callbacks = {}
        
    def handle_exception(
        self, 
        exception: Exception, 
        context: Optional[ErrorContext] = None,
        reraise: bool = True
    ) -> bool:
        """
        Centralized exception handling with logging and recovery.
        
        Args:
            exception: The exception to handle
            context: Additional error context
            reraise: Whether to re-raise the exception
            
        Returns:
            bool: True if error was handled successfully, False otherwise
        """
        try:
            # Ensure we have proper exception context
            if isinstance(exception, DecentralizedAISimulationException):
                if context:
                    exception.context = context
                error_context = exception.context
            else:
                # Wrap system exception
                error_context = context or ErrorContext(
                    component=self.component,
                    severity=ErrorSeverity.HIGH,
                    category=ErrorCategory.SYSTEM
                )
                exception = DecentralizedAISimulationException(
                    str(exception), 
                    error_context, 
                    cause=exception
                )
                error_context = exception.context
            
            # Add component information
            error_context.component = self.component
            
            # Log the error
            self._log_error(exception)
            
            # Track error frequency
            self._track_error(exception)
            
            # Try to recover if strategy exists
            recovery_successful = self._attempt_recovery(exception)
            
            # Execute callbacks if any
            self._execute_callbacks(exception)
            
            # Re-raise if requested
            if reraise:
                raise exception
                
            return recovery_successful
            
        except Exception as handling_error:
            logger.error(f"Error handler failed: {handling_error}")
            return False
    
    def _log_error(self, exception: DecentralizedAISimulationException) -> None:
        """Log error with appropriate level based on severity."""
        log_data = exception.context.to_dict()
        log_data['exception_type'] = exception.__class__.__name__
        log_data['error_message'] = str(exception)
        
        if exception.cause:
            log_data['original_exception'] = str(exception.cause)
            log_data['traceback'] = traceback.format_exception(
                type(exception.cause), 
                exception.cause, 
                exception.cause.__traceback__
            )
        
        # Log based on severity
        severity = exception.context.severity
        if severity == ErrorSeverity.CRITICAL:
            logger.critical(f"CRITICAL ERROR: {exception.message}", extra=log_data)
        elif severity == ErrorSeverity.HIGH:
            logger.error(f"HIGH ERROR: {exception.message}", extra=log_data)
        elif severity == ErrorSeverity.MEDIUM:
            logger.warning(f"MEDIUM ERROR: {exception.message}", extra=log_data)
        elif severity == ErrorSeverity.LOW:
            logger.info(f"LOW ERROR: {exception.message}", extra=log_data)
        else:
            logger.debug(f"INFO: {exception.message}", extra=log_data)
    
    def _track_error(self, exception: DecentralizedAISimulationException) -> None:
        """Track error frequency for monitoring."""
        key = exception.__class__.__name__
        self.error_counts[key] = self.error_counts.get(key, 0) + 1
        
        # Track recent errors (for pattern detection)
        self.recent_errors.append({
            'timestamp': datetime.now(),
            'type': key,
            'context': exception.context.to_dict()
        })
        
        # Limit recent errors list
        if len(self.recent_errors) > self.max_recent_errors:
            self.recent_errors.pop(0)
    
    def _attempt_recovery(self, exception: DecentralizedAISimulationException) -> bool:
        """Attempt automatic recovery if strategy exists."""
        exception_type = type(exception)
        if exception_type in self.recovery_strategies:
            try:
                strategy = self.recovery_strategies[exception_type]
                return strategy(exception)
            except Exception as recovery_error:
                logger.error(f"Recovery strategy failed: {recovery_error}")
                return False
        return False
    
    def _execute_callbacks(self, exception: DecentralizedAISimulationException) -> None:
        """Execute registered error callbacks."""
        exception_type = type(exception)
        if exception_type in self.error_callbacks:
            try:
                for callback in self.error_callbacks[exception_type]:
                    callback(exception)
            except Exception as callback_error:
                logger.error(f"Error callback failed: {callback_error}")
    
    def register_recovery_strategy(
        self, 
        exception_type: Type[Exception], 
        strategy: Callable[[Exception], bool]
    ) -> None:
        """Register a recovery strategy for specific exception types."""
        self.recovery_strategies[exception_type] = strategy
    
    def register_error_callback(
        self, 
        exception_type: Type[Exception], 
        callback: Callable[[Exception], None]
    ) -> None:
        """Register a callback for specific exception types."""
        if exception_type not in self.error_callbacks:
            self.error_callbacks[exception_type] = []
        self.error_callbacks[exception_type].append(callback)
    
    def get_error_statistics(self) -> Dict[str, Any]:
        """Get error statistics for monitoring."""
        return {
            'error_counts': self.error_counts,
            'recent_error_count': len(self.recent_errors),
            'component': self.component,
            'last_updated': datetime.now().isoformat()
        }

# Global error handler instance
_global_error_handler = ErrorHandler()

def error_handler(
    component: str = "main",
    reraise: bool = True,
    severity: ErrorSeverity = ErrorSeverity.MEDIUM,
    category: ErrorCategory = ErrorCategory.SYSTEM
):
    """Decorator for automatic error handling."""
    
    def decorator(func: Callable) -> Callable:
        @functools.wraps(func)
        def wrapper(*args, **kwargs):
            context = ErrorContext(
                component=component,
                operation=func.__name__
            )
            
            try:
                return func(*args, **kwargs)
            except Exception as e:
                if not isinstance(e, DecentralizedAISimulationException):
                    # Wrap system exception
                    e = DecentralizedAISimulationException(
                        str(e), 
                        context, 
                        cause=e
                    )
                
                return _global_error_handler.handle_exception(e, reraise=reraise)
        
        return wrapper
    
    return decorator

def async_error_handler(
    component: str = "main",
    reraise: bool = True
):
    """Decorator for automatic async error handling."""
    
    def decorator(func: Callable) -> Callable:
        @functools.wraps(func)
        async def wrapper(*args, **kwargs):
            context = ErrorContext(
                component=component,
                operation=func.__name__
            )
            
            try:
                return await func(*args, **kwargs)
            except Exception as e:
                if not isinstance(e, DecentralizedAISimulationException):
                    # Wrap system exception
                    e = DecentralizedAISimulationException(
                        str(e), 
                        context, 
                        cause=e
                    )
                
                return _global_error_handler.handle_exception(e, reraise=reraise)
        
        return wrapper
    
    return decorator

@contextmanager
def error_context(
    severity: ErrorSeverity = ErrorSeverity.MEDIUM,
    category: ErrorCategory = ErrorCategory.SYSTEM,
    component: str = "main",
    operation: str = "unknown",
    **additional_context
):
    """Context manager for error context tracking."""
    context = ErrorContext(
        severity=severity,
        category=category,
        component=component,
        operation=operation,
        additional_context=additional_context
    )
    
    try:
        yield context
    except Exception as e:
        if not isinstance(e, DecentralizedAISimulationException):
            e = DecentralizedAISimulationException(str(e), context, cause=e)
        _global_error_handler.handle_exception(e)
        raise

class ValidationHelper:
    """Helper class for common validation patterns."""
    
    @staticmethod
    def require_not_none(value: Any, field_name: str, context: Optional[ErrorContext] = None) -> Any:
        """Validate that value is not None."""
        if value is None:
            raise ValidationException(
                f"{field_name} cannot be None",
                field_name=field_name,
                value=value
            )
        return value
    
    @staticmethod
    def require_not_empty(value: Union[str, list, dict], field_name: str) -> Any:
        """Validate that value is not empty."""
        if not value:
            raise ValidationException(
                f"{field_name} cannot be empty",
                field_name=field_name,
                value=value
            )
        return value
    
    @staticmethod
    def require_type(value: Any, expected_type: Type, field_name: str) -> Any:
        """Validate that value has expected type."""
        if not isinstance(value, expected_type):
            raise ValidationException(
                f"{field_name} must be of type {expected_type.__name__}, got {type(value).__name__}",
                field_name=field_name,
                value=value
            )
        return value
    
    @staticmethod
    def require_range(value: Union[int, float], min_val: float, max_val: float, field_name: str) -> Any:
        """Validate that value is within specified range."""
        if not (min_val <= value <= max_val):
            raise ValidationException(
                f"{field_name} must be between {min_val} and {max_val}, got {value}",
                field_name=field_name,
                value=value
            )
        return value

# Recovery strategies
def create_retry_strategy(max_retries: int = 3, backoff_factor: float = 1.0):
    """Create a retry-based recovery strategy."""
    
    def retry_strategy(exception: Exception) -> bool:
        # Simple retry logic - can be enhanced based on specific needs
        logger.info(f"Attempting recovery for {type(exception).__name__}")
        return True  # Simple implementation
    
    return retry_strategy

def create_fallback_strategy(fallback_func: Callable):
    """Create a fallback-based recovery strategy."""
    
    def fallback_recovery(exception: Exception) -> bool:
        try:
            fallback_func(exception)
            return True
        except Exception as e:
            logger.error(f"Fallback strategy failed: {e}")
            return False
    
    return fallback_recovery

# Performance monitoring
class PerformanceMonitor:
    """Monitor performance and detect degradation."""
    
    def __init__(self, warning_threshold: float = 5.0):
        self.warning_threshold = warning_threshold
        self.performance_metrics = {}
    
    @contextmanager
    def monitor_operation(self, operation_name: str):
        """Monitor an operation for performance issues."""
        start_time = datetime.now()
        
        try:
            yield
        finally:
            end_time = datetime.now()
            duration = (end_time - start_time).total_seconds()
            
            if duration > self.warning_threshold:
                raise PerformanceException(
                    f"Operation {operation_name} took {duration:.2f}s, exceeding threshold of {self.warning_threshold}s",
                    operation=operation_name,
                    duration=duration,
                    threshold=self.warning_threshold
                )
            
            self.performance_metrics[operation_name] = {
                'last_duration': duration,
                'timestamp': end_time.isoformat(),
                'threshold': self.warning_threshold
            }

