logger = logging.getLogger(__name__)

class ErrorSeverity(Enum):
    """Error severity levels for proper handling prioritization."""
    CRITICAL = "critical"    # System failure, immediate action required
    HIGH = "high"           # Major functionality affected
    MEDIUM = "medium"       # Minor functionality impact
    LOW = "low"             # Cosmetic issues, warnings
    INFO = "info"           # Informational messages

class ErrorCategory(Enum):
    """Error categories for organization and routing."""
    SYSTEM = "system"
    NETWORK = "network"
    DATABASE = "database"
    SECURITY = "security"
    VALIDATION = "validation"
    RESOURCE = "resource"
    CONFIGURATION = "configuration"
    BUSINESS_LOGIC = "business_logic"
    INTEGRATION = "integration"
    PERFORMANCE = "performance"

@dataclass
class ErrorContext:
    """Container for error context information."""
    error_id: str = field(default_factory=lambda: str(uuid.uuid4()))
    timestamp: datetime = field(default_factory=datetime.now)
    severity: ErrorSeverity = ErrorSeverity.MEDIUM
    category: ErrorCategory = ErrorCategory.SYSTEM
    component: str = "unknown"
    operation: str = "unknown"
    user_id: Optional[str] = None
    session_id: Optional[str] = None
    request_id: Optional[str] = None
    additional_context: Dict[str, Any] = field(default_factory=dict)
    
    def to_dict(self) -> Dict[str, Any]:
        """Convert error context to dictionary for logging."""
        return {
            'error_id': self.error_id,
            'timestamp': self.timestamp.isoformat(),
            'severity': self.severity.value,
            'category': self.category.value,
            'component': self.component,
            'operation': self.operation,
            'user_id': self.user_id,
            'session_id': self.session_id,
            'request_id': self.request_id,
            'additional_context': self.additional_context
        }

class DecentralizedAISimulationException(Exception):
    """Base exception for the Decentralized AI Simulation Platform."""
    
    def __init__(
        self, 
        message: str, 
        context: Optional[ErrorContext] = None,
        cause: Optional[Exception] = None,
        remediation: Optional[str] = None
    ):
        super().__init__(message)
        self.message = message
        self.context = context or ErrorContext()
        self.cause = cause
        self.remediation = remediation
        self.timestamp = datetime.now()
        
        # Add contextual information
        self.context.additional_context.update({
            'exception_type': self.__class__.__name__,
            'exception_module': self.__class__.__module__,
            'error_message': message
        })

class CriticalSystemException(DecentralizedAISimulationException):
    """Exception for critical system failures requiring immediate attention."""
    
    def __init__(self, message: str, context: Optional[ErrorContext] = None, **kwargs):
        super().__init__(message, context or ErrorContext(severity=ErrorSeverity.CRITICAL), **kwargs)
        self.context.severity = ErrorSeverity.CRITICAL

class ValidationException(DecentralizedAISimulationException):
    """Exception for data validation failures."""
    
    def __init__(self, message: str, field_name: Optional[str] = None, value: Any = None, **kwargs):
        context = ErrorContext(
            category=ErrorCategory.VALIDATION,
            severity=ErrorSeverity.MEDIUM
        )
        if field_name and value is not None:
            context.additional_context.update({
                'field_name': field_name,
                'invalid_value': value,
                'validation_type': 'field_validation'
            })
        super().__init__(message, context, **kwargs)

